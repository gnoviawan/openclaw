# ============================================================================
# OpenClaw VPS Deployment Configuration
# ============================================================================
# Copy this file to .env and configure your settings.
# All variables are optional unless marked as REQUIRED.
#
# Documentation: https://github.com/openclaw/openclaw/blob/main/docs/install/vps-standalone.md
# ============================================================================

# ============================================================================
# DOCKER IMAGE
# ============================================================================

# Docker image to use (default: latest from main branch)
# Available tags:
#   - main          : Latest from main branch (default)
#   - vX.Y.Z        : Specific version (e.g., v2026.1.29)
#   - vX.Y.Z-amd64  : AMD64 architecture only
#   - vX.Y.Z-arm64  : ARM64 architecture only
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:main

# ============================================================================
# GATEWAY CONFIGURATION (REQUIRED)
# ============================================================================

# REQUIRED: Gateway authentication token
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-secure-token-here

# Optional: Gateway password (required for Tailscale funnel)
# OPENCLAW_GATEWAY_PASSWORD=

# Gateway network configuration
# Options:
#   - localhost : Only accessible from the container (most restrictive)
#   - lan       : Accessible from the local network (recommended for VPS)
#   - all       : Accessible from anywhere (use with caution)
OPENCLAW_GATEWAY_BIND=lan

# Port configuration
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# ============================================================================
# DATA DIRECTORIES
# ============================================================================

# Data directories (relative paths work if docker-compose.vps.yml is in same directory)
# These directories will be created automatically
OPENCLAW_CONFIG_DIR=./data/config
OPENCLAW_WORKSPACE_DIR=./data/workspace

# ============================================================================
# OPENCLAW PROFILE & PATHS
# ============================================================================

# Profile name for multi-instance deployments (default: default)
# OPENCLAW_PROFILE=default

# Custom state directory (inside container)
# OPENCLAW_STATE_DIR=

# Custom config file path (inside container)
# OPENCLAW_CONFIG_PATH=

# Custom agent directory (inside container)
# OPENCLAW_AGENT_DIR=

# ============================================================================
# SYSTEM
# ============================================================================

# Timezone (default: UTC)
# Use IANA timezone format: America/New_York, Europe/London, Asia/Tokyo, etc.
TZ=UTC

# Node environment (default: production)
# NODE_ENV=production

# ============================================================================
# AI PROVIDER API KEYS
# ============================================================================
# Configure at least ONE provider to enable AI capabilities.
# You can configure multiple providers for failover and model selection.

# --- Anthropic (Claude) ---
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OAuth token (alternative to API key for enterprise)
# ANTHROPIC_OAUTH_TOKEN=

# --- OpenAI ---
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Custom TTS endpoint (default: https://api.openai.com/v1)
# OPENAI_TTS_BASE_URL=

# --- Google Gemini ---
# Get your key at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=

# --- Groq ---
# Get your key at: https://console.groq.com/
# GROQ_API_KEY=gsk_...

# --- OpenRouter ---
# Get your key at: https://openrouter.ai/keys
# Provides access to multiple models through a single API
# OPENROUTER_API_KEY=sk-or-...

# --- xAI (Grok) ---
# XAI_API_KEY=

# --- Z.AI (GLM models) ---
# Use zai/glm-4.7 as your model
# ZAI_API_KEY=
# Z_AI_API_KEY=  # Legacy alias

# --- Synthetic ---
# Anthropic-compatible API for various models
# SYNTHETIC_API_KEY=

# --- Mistral ---
# Get your key at: https://console.mistral.ai/
# MISTRAL_API_KEY=

# --- Cerebras ---
# CEREBRAS_API_KEY=

# --- Deepgram (Speech-to-Text) ---
# Get your key at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=

# --- Venice AI ---
# VENICE_API_KEY=

# --- Moonshot ---
# MOONSHOT_API_KEY=

# --- Kimi Code ---
# KIMICODE_API_KEY=

# --- MiniMax ---
# MINIMAX_API_KEY=

# --- Xiaomi ---
# XIAOMI_API_KEY=

# --- OpenCode ---
# OPENCODE_API_KEY=

# --- Perplexity ---
# Get your key at: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=

# --- Vercel AI Gateway ---
# AI_GATEWAY_API_KEY=

# --- Chutes ---
# CHUTES_API_KEY=
# CHUTES_OAUTH_TOKEN=

# --- Qwen Portal ---
# QWEN_PORTAL_API_KEY=
# QWEN_OAUTH_TOKEN=

# --- GitHub Copilot ---
# Use one of these tokens for GitHub Copilot models
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=

# ============================================================================
# AWS BEDROCK
# ============================================================================
# Use Amazon Bedrock models via the AWS SDK credential chain.
# See: docs/bedrock.md

# AWS credentials (explicit)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=

# Session token (for temporary credentials)
# AWS_SESSION_TOKEN=

# Region configuration
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Profile name (for shared credentials file)
# AWS_PROFILE=default

# Bedrock bearer token (alternative auth)
# AWS_BEARER_TOKEN_BEDROCK=

# ============================================================================
# MESSAGING CHANNEL TOKENS
# ============================================================================
# Configure tokens for the messaging platforms you want to use.
# Alternatively, use the CLI: openclaw channels add --channel <name> --token <token>

# --- Telegram ---
# Create a bot at: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=

# --- Discord ---
# Create a bot at: https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=

# --- Slack ---
# Create an app at: https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# --- Twilio (WhatsApp) ---
# Get credentials at: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+1...

# --- LINE ---
# Create a channel at: https://developers.line.biz/
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# ============================================================================
# TOOLS CONFIGURATION
# ============================================================================

# --- Web Search (Brave) ---
# Get your key at: https://brave.com/search/api/
# Use the "Data for Search" plan (NOT "Data for AI")
# BRAVE_API_KEY=

# --- Firecrawl (Web Scraping) ---
# FIRECRAWL_API_KEY=

# --- Text-to-Speech (ElevenLabs) ---
# Get your key at: https://elevenlabs.io/
# ELEVENLABS_API_KEY=
# XI_API_KEY=  # Alternative env var for ElevenLabs

# ============================================================================
# DEBUG & DEVELOPMENT
# ============================================================================
# These options are primarily for development and troubleshooting.
# Leave empty or unset for production deployments.

# Enable detailed Telegram account logging
# OPENCLAW_DEBUG_TELEGRAM_ACCOUNTS=1

# Log Anthropic API payloads (for debugging)
# OPENCLAW_ANTHROPIC_PAYLOAD_LOG=1
# OPENCLAW_ANTHROPIC_PAYLOAD_LOG_FILE=/path/to/payload.log

# Cache trace logging (for debugging cache behavior)
# OPENCLAW_CACHE_TRACE=1
# OPENCLAW_CACHE_TRACE_FILE=/path/to/cache-trace.jsonl
# OPENCLAW_CACHE_TRACE_MESSAGES=1
# OPENCLAW_CACHE_TRACE_PROMPT=1
# OPENCLAW_CACHE_TRACE_SYSTEM=1

# Skip canvas host (useful in headless environments)
# OPENCLAW_SKIP_CANVAS_HOST=1

# Bash pending output character limit
# OPENCLAW_BASH_PENDING_MAX_OUTPUT_CHARS=

# Eager channel options loading
# OPENCLAW_EAGER_CHANNEL_OPTIONS=1

# Log Claude CLI output
# OPENCLAW_CLAUDE_CLI_LOG_OUTPUT=1

# Terminal color control
# FORCE_COLOR=1  # Force colors even in non-TTY
# NO_COLOR=1     # Disable all colors

# ============================================================================
# CUSTOM PACKAGES & BINARIES
# ============================================================================
# There are 3 ways to add custom packages/binaries to your deployment:
#
# --- Option 1: Build a custom image (RECOMMENDED for persistence) ---
# Edit Dockerfile.vps.custom, then:
#   docker build -f Dockerfile.vps.custom -t openclaw-custom:latest .
#   OPENCLAW_IMAGE=openclaw-custom:latest
#
# --- Option 2: Runtime installation (packages installed on every restart) ---
# Use the openclaw-gateway-custom service with OPENCLAW_APT_PACKAGES:
#   OPENCLAW_APT_PACKAGES=ffmpeg imagemagick git
# Then run:
#   docker compose -f docker-compose.vps.yml --profile custom up -d openclaw-gateway-custom
#
# --- Option 3: Mount host binaries (for binaries available on host) ---
# Edit docker-compose.vps.yml to uncomment volume mounts:
#   - /usr/bin/ffmpeg:/usr/bin/ffmpeg:ro
# And set PATH prepend:
#   OPENCLAW_PATH_PREPEND=/usr/local/custom-bin

# Apt packages to install at runtime (for openclaw-gateway-custom service)
# Space-separated list of packages
# OPENCLAW_APT_PACKAGES=ffmpeg imagemagick

# Custom init script path (for openclaw-gateway-custom service)
# Script runs as root before gateway starts
# OPENCLAW_INIT_SCRIPT=./init.sh

# Prepend to PATH (for mounted binaries)
# OPENCLAW_PATH_PREPEND=/usr/local/custom-bin

# ============================================================================
# EXAMPLE: MINIMAL CONFIGURATION
# ============================================================================
# For a minimal setup with Anthropic Claude and Telegram:
#
# OPENCLAW_GATEWAY_TOKEN=<generate-with-openssl>
# ANTHROPIC_API_KEY=sk-ant-...
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
#
# Then run:
#   docker compose -f docker-compose.vps.yml up -d openclaw-gateway
#
# ============================================================================
